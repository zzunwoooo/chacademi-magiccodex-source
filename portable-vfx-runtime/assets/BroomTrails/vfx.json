 "features": {
  "catalog": {
   "billboard": {
    "visualImpact": "high",
    "description": "camera-facing quads"
   },
   "stretchedBillboard": {
    "visualImpact": "medium",
    "description": "quads stretched along velocity (streaks, sparks, flame tongues)"
   },
   "meshParticle": {
    "visualImpact": "high",
    "description": "each particle is a ribbon mesh (swirls, arcs, rings); defines the silhouette of strokes"
   },
   "flipbook": {
    "visualImpact": "high",
    "description": "texture sheet animation over lifetime (cel flame/smoke/stroke wipes)"
   },
   "additiveBlend": {
    "visualImpact": "high",
    "description": "additive blending for glows and strokes"
   },
   "alphaBlend": {
    "visualImpact": "high",
    "description": "straight alpha blending for cel flames, smoke, ink"
   },
   "hdrTint": {
    "visualImpact": "medium",
    "description": "material tint above 1.0; only visible as extra glow when bloom exists"
   },
   "bloom": {
    "visualImpact": "high",
    "description": "post bloom on HDR values; the anime glow look depends on it"
   },
   "tonemapNeutral": {
    "visualImpact": "low",
    "description": "Neutral tonemapping of the HDR image"
   },
   "worldSpace": {
    "visualImpact": "medium",
    "description": "particles stay where spawned while the emitter moves (trails)"
   },
   "rateOverDistance": {
    "visualImpact": "medium",
    "description": "emission proportional to emitter travel distance"
   },
   "rotation3D": {
    "visualImpact": "medium",
    "description": "per-particle 3D start rotation (mesh particles)"
   },
   "rotationOverLifetime": {
    "visualImpact": "medium",
    "description": "spinning particles (mesh spin is the swirl motion)"
   },
   "orbitalVelocity": {
    "visualImpact": "high",
    "description": "positions orbit the layer Y axis (vortex motion)"
   },
   "radialVelocity": {
    "visualImpact": "low",
    "description": "positions pushed away from the layer origin"
   },
   "linearVelocity": {
    "visualImpact": "low",
    "description": "velocity over lifetime (rising smoke/flames)"
   },
   "gravity": {
    "visualImpact": "low",
    "description": "gravity modifier"
   },
   "drag": {
    "visualImpact": "low",
    "description": "velocity damping"
   },
   "noise": {
    "visualImpact": "low",
    "description": "turbulent flutter of embers/sparkles (SCHEMA §4.3 function)"
   },
   "trails": {
    "visualImpact": "medium",
    "description": "per-particle ribbon trails"
   },
   "attachedFollow": {
    "visualImpact": "high",
    "description": "role \"attached\": the system transform follows a moving entity every frame (buffs/auras, SCHEMA §5)"
   },
   "linkTarget": {
    "visualImpact": "high",
    "description": "role \"link\": the system frame spans source → target (two runtime points, every frame) and exposes linkLength (SCHEMA §5)"
   },
   "pathFollow": {
    "visualImpact": "high",
    "description": "particle position follows a curved path from its spawn point to the link target over its lifetime (SCHEMA §4.8)"
   },
   "salvoSequence": {
    "visualImpact": "high",
    "description": "top-level salvo: N projectile instances fired one by one from caster-relative slots at fireStart + k·fireInterval (runtime inputs), each stopping its idle systems (SCHEMA §5.2)"
   },
   "instanceScale": {
    "visualImpact": "medium",
    "description": "whole cast scaled uniformly by clamp(input / reference, min, max) from a runtime input: targetHeight or (1.11.0) areaRadius; (1.15.0) only the systems in scale.systems when that list is given (SCHEMA §5.3)"
   },
   "phasedSequence": {
    "visualImpact": "high",
    "description": "systems with phase begin/sustain/end played on the sequence timeline with a runtime hold duration (SCHEMA §5.1)"
   },
   "depthWrite": {
    "visualImpact": "high",
    "description": "material writes depth (opaque alpha-blended solid mesh, e.g. a 3D rock): its own faces and later-drawn particles are depth-tested against it (SCHEMA §2 Material, 1.8.0)"
   },
   "flipbookCycles": {
    "visualImpact": "medium",
    "description": "flipbook.cycles > 1: the sheet loops several times per lifetime (flickering flames on long-lived particles, SCHEMA §4.5, 1.9.0)"
   },
   "stopTail": {
    "visualImpact": "medium",
    "description": "onStop.mode \"jumpToTail\": when the system stops emitting, live particles skip ahead so only `tail` s of life remain (they play their fade/break-up end at once, SCHEMA §4.9, 1.9.0)"
   },
   "modelParticle": {
    "visualImpact": "high",
    "description": "render.type \"model\": each particle is an animated 3D model (glTF binary, rigid node hierarchy, node TRS clips, vertex colors; 1.13.0: embedded baseColor textures, toon ramp, outline) shaded by models[].shading (SCHEMA §4.10)"
   },
   "widthScale": {
    "visualImpact": "high",
    "description": "top-level width: the listed systems are stretched along their right axis by clamp(effectWidth / reference, min, max) from a runtime input; listed layers scale their emission counts by the same factor (SCHEMA §5.4, 1.12.0)"
   },
   "triggeredEnd": {
    "visualImpact": "high",
    "description": "external trigger signal ends the phased sequence early with its own end branch (e.g. trap explosion) instead of the quiet expire end (SCHEMA §5.1, 1.7.0)"
   }
  },
