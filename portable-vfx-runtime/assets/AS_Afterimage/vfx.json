   },
   "bloom": {
    "visualImpact": "high",
    "description": "post bloom on HDR values; the anime glow look depends on it"
   },
   "tonemapNeutral": {
    "visualImpact": "low",
    "description": "Neutral tonemapping of the HDR image"
   },
   "worldSpace": {
    "visualImpact": "medium",
